{
  "name": "coding-comfort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.mjs",
    "convex:deploy": "convex deploy",
    "admin:configure-auth": "node scripts/configure-auth.mjs",
    "admin:provision": "node scripts/provision-researcher.mjs",
    "test:navigation": "node scripts/check-navigation.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"convex/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"convex/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "jose": "^6.2.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
